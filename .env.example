# Database
POSTGRES_USER=roundtuit
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=roundtuit

# Backend
DATABASE_URL=postgresql://roundtuit:change-me-to-a-strong-password@postgres:5432/roundtuit
JWT_SECRET=change-me-to-a-random-32-byte-hex-string
JWT_EXPIRES_IN=7d
NODE_ENV=production
PORT=4000
FRONTEND_URL=https://your-domain.example.com

# Frontend
VITE_API_URL=

# Backups — absolute path on the host where backup files will be stored
# e.g. /mnt/nas/roundtuit-backups or /home/user/roundtuit-backups
BACKUP_DIR=/home/user/roundtuit-backups

# Uploads — absolute path on the host where task image uploads will be stored
# e.g. /mnt/nas/roundtuit-uploads or /home/user/roundtuit-uploads
UPLOAD_DIR=/home/user/roundtuit-uploads

# Telegram notifications (optional — leave blank to disable)
# Create a bot via @BotFather in Telegram, then paste the token it gives you
TELEGRAM_BOT_TOKEN=
