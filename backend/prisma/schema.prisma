generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Importance {
  HIGH
  MEDIUM
  LOW
}

enum TaskStatus {
  PENDING
  STARTED
  WAITING
  COMPLETED
}

model AllowedUsername {
  id        String   @id @default(cuid())
  username  String   @unique
  createdAt DateTime @default(now())
}

model User {
  id                     String   @id @default(cuid())
  username               String   @unique
  passwordHash           String
  passwordChangeRequired Boolean  @default(false)
  telegramChatId         String?
  telegramLinkCode       String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  tasks                  Task[]
}

model Task {
  id                String     @id @default(cuid())
  title             String
  description       String?
  dueDate           DateTime?
  importance        Importance @default(MEDIUM)
  status            TaskStatus @default(PENDING)
  statusChangedAt   DateTime?
  reminder2DaysSent Boolean    @default(false)
  reminder1DaySent  Boolean    @default(false)
  reminderTodaySent Boolean    @default(false)
  createdBy         String
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  user              User       @relation(fields: [createdBy], references: [id], onDelete: Cascade)
}
