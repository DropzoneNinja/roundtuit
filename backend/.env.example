# Database — must match POSTGRES_USER/PASSWORD/DB in docker-compose.prod.yml
DATABASE_URL=postgresql://roundtuit:CHANGE_ME_DB_PASSWORD@postgres:5432/roundtuit

# JWT — generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
JWT_EXPIRES_IN=7d

# Server
NODE_ENV=production
PORT=4000

# CORS — set to your public domain (no trailing slash)
FRONTEND_URL=https://yourdomain.com

# Optional: restrict new registrations to specific email domains (comma-separated)
# Leave empty to allow any email in the allowed_emails table
ALLOWED_EMAIL_DOMAINS=

