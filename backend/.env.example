# Database — must match POSTGRES_USER/PASSWORD/DB in docker-compose.prod.yml
DATABASE_URL=postgresql://roundtuit:CHANGE_ME_DB_PASSWORD@postgres:5432/roundtuit

# JWT — generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
JWT_EXPIRES_IN=7d

# Server
NODE_ENV=production
PORT=4000

# CORS — set to your public domain (no trailing slash)
FRONTEND_URL=https://yourdomain.com

# Optional: restrict new registrations to specific email domains (comma-separated)
# Leave empty to allow any email in the allowed_emails table
ALLOWED_EMAIL_DOMAINS=

# Telegram notifications (optional — leave blank to disable)
# Create a bot via @BotFather in Telegram, then paste the token it gives you
TELEGRAM_BOT_TOKEN=

# Directory for uploaded task images — mounted as a docker volume
# Dev default: ./uploads  |  Prod: set this to an absolute host path
UPLOAD_DIR=/your/path/to/uploads

